[Unit]
Description=XUAN Claude-DE local CONNECT authentication bridge
After=xuan-claude-de.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xuan-vps-proxy
Group=xuan-vps-proxy
ExecStart=/usr/local/libexec/xuan-claude-de-connect.py --listen 127.0.0.1:12345
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/xuan-vps/redsocks.conf

[Install]
WantedBy=multi-user.target
