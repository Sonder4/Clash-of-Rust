[Unit]
Description=XUAN Claude-DE fail-closed firewall
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/xuan-claude-de-firewall start
ExecStop=/usr/local/sbin/xuan-claude-de-firewall stop
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
