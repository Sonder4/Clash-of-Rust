[Unit]
Description=XUAN Claude-DE HTTP CONNECT bridge
After=xuan-claude-de.service
Requires=xuan-claude-de.service

[Service]
User=xuan-vps-proxy
Group=xuan-vps-proxy
ExecStart=/usr/sbin/redsocks -c /etc/xuan-vps/redsocks.conf -p /run/xuan-vps/redsocks.pid
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
