import { ScrollView } from "std-widgets.slint";
import { PageSurface } from "../components/motion.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { Theme } from "../theme/palette.slint";
import { Label, Caption, Heading, Paragraph, ContentPanel, ActionButton, Field, Badge, Divider } from "../components/controls.slint";

component WslActionButton inherits ActionButton {
    in property <string> action;
    in property <string> mode: "execute";
    enabled: UiData.wsl-supported && !UiData.wsl-busy && !UiData.exiting;
    clicked => { UiActions.dispatch(Intent.wsl-action, root.action, root.mode); }
}

component WslField inherits Field {
    in property <string> argument;
    enabled: UiData.wsl-supported && !UiData.wsl-busy && !UiData.exiting;
    opacity: root.enabled ? 1 : 0.5;
    edited(value) => { UiActions.dispatch(Intent.wsl-input, root.argument, value); }
}

component StatusRow inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <bool> highlight: false;
    height: 26px;
    HorizontalLayout {
        cross-axis-alignment: center;
        spacing: Theme.content-gap;
        Caption { text: root.title; horizontal-stretch: 1; }
        Label {
            text: root.value;
            horizontal-alignment: right;
            color: root.highlight ? Theme.accent : Theme.secondary;
        }
    }
}

export component WslPage inherits PageSurface {
    property <bool> logs-open: false;
    ScrollView {
        x: 0px;
        width: parent.width + Theme.content-gap;
        VerticalLayout {
            alignment: start;
            padding-right: Theme.content-gap;
            padding-bottom: Theme.card-padding;
            spacing: Theme.page-gap;
            ContentPanel {
                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: Theme.content-gap;
                    Heading { text: "Clash of WSL"; horizontal-stretch: 1; }
                    Badge {
                        text: UiData.wsl-busy ? "处理中" : UiData.wsl-tunnel == "connected" ? "已连接" : UiData.wsl-status == "blocked" ? "受阻" : UiData.wsl-status == "failed" ? "失败" : "未连接";
                        tone: UiData.wsl-tunnel == "connected" ? 1 : UiData.wsl-busy ? 2 : 3;
                    }
                }
                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: Theme.content-gap;
                    Caption { text: "出口 IP"; horizontal-stretch: 1; }
                    Label { text: UiData.wsl-exit; color: Theme.accent; horizontal-alignment: right; }
                    Caption { text: "阶段"; }
                    Label { text: UiData.wsl-phase; horizontal-alignment: right; }
                }
                Divider { }
                StatusRow { title: "保护"; value: UiData.wsl-protection; }
                StatusRow { title: "验收"; value: UiData.wsl-functional; }
                if UiData.wsl-message != "": Paragraph { text: UiData.wsl-message; color: Theme.secondary; }
                if UiData.wsl-guidance != "": Paragraph { text: UiData.wsl-guidance; color: Theme.warning; }
            }
            ContentPanel {
                Heading { text: "操作"; }
                HorizontalLayout {
                    spacing: Theme.content-gap;
                    if !UiData.wsl-installed: WslActionButton { text: "安装"; action: "Install"; primary: true; }
                    if UiData.wsl-installed: WslActionButton { text: "连接"; action: "Start"; primary: true; enabled: UiData.wsl-supported && !UiData.wsl-busy && !UiData.exiting && UiData.wsl-installed; }
                    if UiData.wsl-installed: WslActionButton { text: "断开"; action: "Stop"; enabled: UiData.wsl-supported && !UiData.wsl-busy && !UiData.exiting && UiData.wsl-installed; }
                    WslActionButton { text: "状态"; action: "Status"; mode: "preview"; }
                    WslActionButton { text: "测试"; action: "Test"; mode: "preview"; enabled: UiData.wsl-supported && !UiData.wsl-busy && !UiData.exiting && UiData.wsl-installed; }
                    WslActionButton { text: "预检"; action: "Install"; mode: "preview"; }
                    ActionButton { text: root.logs-open ? "收起日志" : "日志"; clicked => { root.logs-open = !root.logs-open; } }
                }
                HorizontalLayout {
                    spacing: Theme.content-gap;
                    if UiData.wsl-installed: WslActionButton { text: "断开并保留保护"; action: "Rollback"; mode: "execute"; }
                    if UiData.wsl-installed: WslActionButton { text: "恢复原网络"; action: "Rollback"; mode: "restore-confirm"; danger: true; }
                }
                if UiData.wsl-admin-command != "": Paragraph { text: UiData.wsl-admin-command; font-size: Theme.detail-size; color: Theme.secondary; }
            }
            if !UiData.wsl-installed: ContentPanel {
                Heading { text: "安装"; }
                HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: Theme.content-gap;
                    Caption { text: "后端"; horizontal-stretch: 1; }
                    ActionButton {
                        text: "WireGuard";
                        selected: UiData.wsl-backend == "WireGuard";
                        enabled: !UiData.wsl-installed && UiData.wsl-supported && !UiData.wsl-busy && !UiData.exiting;
                        clicked => { UiActions.dispatch(Intent.wsl-input, "backend", "WireGuard"); }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.content-gap;
                    WslField { text <=> UiData.wsl-distro; argument: "distro"; placeholder: "管理发行版"; }
                    WslField { text <=> UiData.wsl-endpoint-ipv4; argument: "endpoint-ipv4"; placeholder: "VPS IPv4"; }
                    WslField { width: 88px; horizontal-stretch: 0; text <=> UiData.wsl-endpoint-port; argument: "endpoint-port"; placeholder: "端口"; }
                }
                HorizontalLayout {
                    spacing: Theme.content-gap;
                    WslField { text <=> UiData.wsl-profile-path; argument: "profile-path"; placeholder: "私密配置 JSON"; }
                    WslActionButton { text: "浏览…"; action: "ChooseProfile"; mode: "preview"; }
                }
            }
            ContentPanel {
                Heading { text: "发行版"; }
                if UiData.wsl-distributions.length == 0: Caption { text: "尚未检测到发行版。"; }
                for distro in UiData.wsl-distributions: HorizontalLayout {
                    cross-axis-alignment: center;
                    spacing: Theme.content-gap;
                    Caption { text: distro.name; horizontal-stretch: 1; }
                    Label { text: distro.state; horizontal-alignment: right; color: Theme.secondary; }
                }
            }
            if root.logs-open: ContentPanel {
                Heading { text: "日志"; }
                if UiData.wsl-logs.length == 0: Caption { text: "暂无记录。"; }
                for line in UiData.wsl-logs: Paragraph { text: line; font-size: Theme.detail-size; color: Theme.secondary; }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
